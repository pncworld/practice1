# 네이버 스마트플레이스 연동 (naverPlacePlus/ 폴더) 전용 환경변수 템플릿
# 실제 값은 .env 파일(git에 커밋되지 않음)에 채워 넣으세요.
# 로컬 테스트: npm run serve  →  http://localhost/naver/start
# (원본처럼 3000번만 따로 띄울 때는 npm run naver:dev)
# 운영 배포 시 BASE_URL 만 https://www.pncoffice.co.kr 로 바꾸면 됩니다.
# ⚠ PORT 는 넣지 마세요. Vue CLI(npm run serve)가 그 값으로 포트를 바꿔 버립니다.

BASE_URL=http://localhost
# 네이버 개발자센터 Callback URL 과 글자 하나까지 같아야 합니다.
NAVER_REDIRECT_URI=http://localhost/naver/login/callback

# 화면에 노출할 우리 회사명 (동의 안내 페이지 브랜딩용)
# 정식 상호명(국문/영문)은 네이버 담당자에게 refreshToken 발급용으로 전달한 값과 동일하게 유지
COMPANY_NAME=PncWorld

# 네이버 앱 정보 (네이버 개발자센터에서 발급)
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# 우리 회사 서비스 식별자 (스마트플레이스 담당자에게 발급받는 코드)
POS_SERVICE_CODE=pnc

# 플레이스 API 호스트
# ⚠ 인증(Auth) API 호스트(newsmartplace.naver.com)와 다른 도메인(pbp.naver.com)이니 헷갈리지 마세요.
PLACE_API_HOST_TEST=https://test-agency-api.pbp.naver.com
PLACE_API_HOST_PROD=https://api.pbp.naver.com
PLACE_API_ENV=test

# 스마트플레이스 프론트엔드(사용자가 직접 보는 화면) 호스트
# 테스트 FE(test-new.smartplace.naver.com)는 브라우저에서 열리지 않음.
# 사람이 보는 약관/업체찾기는 SMARTPLACE_FRONT_HOST_PROD 를 씁니다.
SMARTPLACE_FRONT_HOST_TEST=https://test-new.smartplace.naver.com
SMARTPLACE_FRONT_HOST_PROD=https://new.smartplace.naver.com

# 인증(Access Token 발급) API 호스트
AUTH_API_HOST_TEST=https://test-api.newsmartplace.naver.com
AUTH_API_HOST_PROD=https://api.newsmartplace.naver.com

# 각 매장(가맹점)별 Refresh Token은 DB에 저장해서 관리해야 합니다.
# 여기서는 데모용으로 단일 값만 둡니다. 실서비스에서는 절대 .env에 두지 마세요.
DEMO_REFRESH_TOKEN=REPLACE_ME

# ------------------------------------------------------------------
# "매출(Bill) API / POS 운영시간 전달 API"를 위한 새 인증 체계(PBP Auth API)용
# 값입니다. 아직 네이버 담당자에게 발급받지 못했으므로 채우지 않은 상태입니다.
# (naverPlacePlus/services/pbpAuth.js 참고 — 발급받으면 이 값들을 채우고 사용하면 됩니다.)
# ------------------------------------------------------------------
PBP_AUTH_API_HOST_TEST=https://test-agency-auth-api.pbp.naver.com
PBP_AUTH_API_HOST_PROD=https://auth-api.pbp.naver.com
PARTNER_SERVER_CLIENT_ID=REPLACE_ME
PARTNER_SERVER_CLIENT_SECRET=REPLACE_ME
